display runs luxury brand videos and close-up product showcases. The lighting system includes individual dimming for each cabinet, allowing staff to create spotlight effects for featured collections.</p><p>Location: UAE</p></div></main><!--$--><!--/$--><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[31262,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"PageViewTracker\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\"]\\n6:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"OutletBoundary\\\"]\\n7:\\\"$Sreact.suspense\\\"\\na:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"ViewportBoundary\\\"]\\nc:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"MetadataBoundary\\\"]\\ne:I[68027,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2xf3yuf2jb148.css\\\",\\\"style\\\"]\\n9:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"case-studies\\\",\\\"jewellery-showroom-led-display-lighting\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[[\\\"slug\\\",\\\"case-studies/jewellery-showroom-led-display-lighting\\\",\\\"c\\\",[\\\"products\\\"]],{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/2xf3yuf2jb148.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\",\\\"async\\\":t