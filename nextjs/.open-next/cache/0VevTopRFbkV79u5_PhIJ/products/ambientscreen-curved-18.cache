 engaging cinema experience.\\u003c/p\\u003e14:[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$15\\\"}}]\\nb:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n8:null\\nd:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"AmbientScreen Curved 1.8 - Innovative Curved LED Display UAE | Brightluxx\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Discover AmbientScreen Curved 1.8 for dynamic curved LED displays in Dubai. Contact Brightluxx UAE to upgrade your display solutions!\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://brightluxx.com/products/ambientscreen-curved-18\\\"}]]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[31262,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"PageViewTracker\"]\n3:I[39756,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n4:I[37457,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n6:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"OutletBoundary\"]\n7:\"$Sreact.suspense\"\na:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"ViewportBoundary\"]\nc:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"MetadataBoundary\"]\ne:I[68027,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/2xf3yuf2jb148.css\",\"style\"]\n9:X\n0:{\"P\":null,\"c\":[\"\",\"products\",\"ambientscreen-curved-18\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[[\"slug\",\"products/ambientscreen-curved-18\",\"c\",[\"products\"]],{\"children\":[\"__PAGE__\",{},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4624],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2xf3yuf2jb148.css\",\"precedenc