ates.</p></div></main><!--$--><!--/$--><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[31262,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"PageViewTracker\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\"]\\n6:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"OutletBoundary\\\"]\\n7:\\\"$Sreact.suspense\\\"\\na:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"ViewportBoundary\\\"]\\nc:I[97367,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"MetadataBoundary\\\"]\\ne:I[68027,[\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2xf3yuf2jb148.css\\\",\\\"style\\\"]\\n9:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"products\\\",\\\"bl-ptr150\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[[\\\"slug\\\",\\\"products/bl-ptr150\\\",\\\"c\\\",[\\\"products\\\"]],{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/2xf3yuf2jb148.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/3hgc05_1jtbhm.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"$L2\\\",null,{}],[\\\"$\\\",\\\"$L3\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$