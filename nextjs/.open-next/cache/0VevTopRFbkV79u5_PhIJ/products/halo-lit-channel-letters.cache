Price\": 500, \"highPrice\": 15000, \"offerCount\": 1, \"availability\": \"https://schema.org/InStock\", \"seller\": {\"@type\": \"Organization\", \"name\": \"Brightluxx\", \"url\": \"https://brightluxx.com\", \"logo\": \"https://files.ihgbrands.com/uploads_hero_banner.webp\"}, \"url\": \"https://brightluxx.com/products/halo-lit-channel-letters\"}, \"additionalProperty\": [{\"@type\": \"PropertyValue\", \"name\": \"Pixel Pitch\", \"value\": \"N/A (LED modules)\"}, {\"@type\": \"PropertyValue\", \"name\": \"Brightness\", \"value\": \"2,000 nits (halo effect)\"}, {\"@type\": \"PropertyValue\", \"name\": \"Warranty\", \"value\": \"3 Years Standard | 5 Years Extended Available\"}]}10:Tb0a,{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What makes Halo-Lit Channel Letters different from traditional channel letters?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Halo-Lit Channel Letters feature a reverse-lit design where the LED modules create a diffused glow behind the letters, offering a sophisticated and modern look compared to the direct illumination of traditional channel letters.\"}}, {\"@type\": \"Question\", \"name\": \"What materials are used for the letter faces and how do they affect durability?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The letter faces are made from brushed aluminum or stainless steel, providing a premium finish that is both durable and weather-resistant, suitable for outdoor use with an IP65 rating.\"}}, {\"@type\": \"Question\", \"name\": \"Can the halo color be customized to match our brand colors?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, the halo colors are customizable with options including White, Warm white, and RGB, allowing you to select colors that best represent your brand identity.\"}}, {\"@type\": \"Question\", \"name\": \"What is the lifespan of the LED modules used in these channel letters?\", \"acceptedAnswe