rCount\": 1, \"availability\": \"https://schema.org/InStock\", \"seller\": {\"@type\": \"Organization\", \"name\": \"Brightluxx\", \"url\": \"https://brightluxx.com\", \"logo\": \"https://files.ihgbrands.com/uploads_hero_banner.webp\"}, \"url\": \"https://brightluxx.com/products/outdoor-smart-tv-65\"}, \"additionalProperty\": [{\"@type\": \"PropertyValue\", \"name\": \"Pixel Pitch\", \"value\": \"N/A\"}, {\"@type\": \"PropertyValue\", \"name\": \"Brightness\", \"value\": \"2,500 nits\"}, {\"@type\": \"PropertyValue\", \"name\": \"Warranty\", \"value\": \"3 Years Standard | 5 Years Extended Available\"}]}10:Taee,{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What makes the Outdoor Smart TV 65\\\" IP55 suitable for outdoor use?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The TV features an IP55 rating, providing protection against dust and water jets, and a brightness of 2,500 nits which ensures clear visibility even in bright sunlight, making it ideal for outdoor environments.\"}}, {\"@type\": \"Question\", \"name\": \"Can this Smart TV be installed by the end-user or does it require professional installation?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"While basic setup like connecting to Wi-Fi can be done by the user, professional installation is recommended to ensure secure mounting and optimal positioning for outdoor conditions.\"}}, {\"@type\": \"Question\", \"name\": \"What is the warranty period for this Outdoor Smart TV?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The Outdoor Smart TV 65\\\" IP55 typically comes with a 1 to 2-year warranty covering manufacturing defects and hardware failures, ensuring reliable use in outdoor settings.\"}}, {\"@type\": \"Question\", \"name\": \"How does this outdoor Smart TV compare to traditional indoor TVs for outdoor use?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Unlike indoor TVs, this model 