 retracts when not in use or in rain to protect the display.\\u003c/p\\u003e\\u003ch3\\u003eCan the screen detect rain automatically?\\u003c/h3\\u003e\\u003cp\\u003eYes, it includes an automatic rain sensor that triggers the screen to retract immediately when rain is detected, ensuring the screen’s protection without manual intervention.\\u003c/p\\u003e14:[\\\"$\\\",\\\"div\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$15\\\"}}]\\nb:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n8:null\\nd:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"PoolView Retractable P2.9 LED Screen | Brightluxx Dubai\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Discover PoolView Retractable P2.9, premium LED display in Dubai. Perfect for poolsides. Contact Brightluxx UAE for a custom solution today!\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://brightluxx.com/products/poolview-retractable-p29\\\"}]]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[31262,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"PageViewTracker\"]\n3:I[39756,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n4:I[37457,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n6:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"OutletBoundary\"]\n7:\"$Sreact.suspense\"\na:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"ViewportBoundary\"]\nc:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"MetadataBoundary\"]\ne:I[68027,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/2xf3yuf2jb148.css\",\"style\"]\n9:X\n0:{\"P\":null,\"c\":[\"\",\"products\",\"poolview-retractable-p29\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[[\"slug\",\"products/poolview-retractable-p29\",\"c\",