pressure water jets from any direction. This rating ensures the display can withstand harsh weather conditions including rain and dust.</p>7:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}]\n8:[\"$\",\"$L15\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@17\"}]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L18\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"UrbanCanvas P6 Outdoor LED Display - Dubai LED Solutions | Brightluxx\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Get UrbanCanvas P6 Outdoor LED displays for vivid visuals in Dubai. Contact Brightluxx UAE for high-quality outdoor LED display solutions.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://brightluxx.com/products/urbancanvas-p6-outdoor\"}]]}]}]}],null]}]\nd:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L1a\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L1b\",null,{}]}]]}]\n10:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2xf3yuf2jb148.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3hgc05_1jtbhm.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"children\":[\"$\",\"body\",null,{\"children\":[[\"$\",\"$L1c\",null,{}],[\"$\",\"$L1a\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L1b\",null,{}],\"notFound\":[[\"$\",\"main\",null,{\"className\":\"not-found\",\"children\":[[\"$\",\"h1\",null,{\"children\":\"404 — Page Not Found\"}],[\"$\",\"p\",null,{\"children\":\"The page you requested does not exist.\"}],[\"$\",\"p\",null