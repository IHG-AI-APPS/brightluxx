n.</p>14:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n8:null\nd:[[\"$\",\"title\",\"0\",{\"children\":\"XR Curve 2.6 - Curved LED Display Solutions Dubai | Brightluxx\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Explore XR Curve 2.6 curved LED display from Brightluxx in Dubai. Enhance your venue’s ambiance. Request a free quote in the UAE today!\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://brightluxx.com/products/xr-curve-26\"}]]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/2xf3yuf2jb148.css\",\"style\"]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":4176,\"slots\":{\"children\":{\"name\":\"slug\",\"param\":{\"type\":\"c\",\"key\":\"products/xr-curve-26\",\"siblings\":[\"products\"]},\"prefetchHints\":4192,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":4256,\"slots\":null}}}}},\"staleTime\":300,\"buildId\":\"0VevTopRFbkV79u5_PhIJ\"}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[31262,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"PageViewTracker\"]\n3:I[39756,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n4:I[37457,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\"]\n6:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"OutletBoundary\"]\n7:\"$Sreact.suspense\"\na:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"ViewportBoundary\"]\nc:I[97367,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"MetadataBoundary\"]\ne:I[68027,[\"/_next/static/chunks/3hgc05_1jtbhm.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/2xf3yuf2jb148.css\",\"style\"]\n9:X\n0:{\"P\":null,\"c\":[\"\",\"products\",\"xr-curve-26\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[[\"slug\",\"products/xr-curve-26\",\"c\",[\"products\"]],{\"children\":[\"__PAGE__\",{},\"$undefined\",\"$undefined\",4608]},\"$und