: 2, \\\"name\\\": \\\"Products\\\", \\\"item\\\": \\\"https://brightluxx.com/products\\\"}, {\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 3, \\\"name\\\": \\\"SportPro 4.7mm\\\", \\\"item\\\": \\\"https://brightluxx.com/products/bl-spx470\\\"}]}\"}}]\n5:[\"$\",\"script\",\"3\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"Organization\\\", \\\"@id\\\": \\\"https://brightluxx.com/#organization\\\", \\\"name\\\": \\\"Brightluxx\\\", \\\"legalName\\\": \\\"Brightluxx LED Displays\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"logo\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"contactPoint\\\": {\\\"@type\\\": \\\"ContactPoint\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"contactType\\\": \\\"sales\\\", \\\"areaServed\\\": [\\\"AE\\\", \\\"SA\\\", \\\"QA\\\", \\\"KW\\\", \\\"BH\\\", \\\"OM\\\"], \\\"availableLanguage\\\": [\\\"en\\\", \\\"ar\\\"]}}\"}}]\n6:[\"$\",\"script\",\"4\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"LocalBusiness\\\", \\\"@id\\\": \\\"https://brightluxx.com/#localbusiness\\\", \\\"name\\\": \\\"Brightluxx LED Displays\\\", \\\"image\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"priceRange\\\": \\\"AED 2,500 - AED 12,000 per m\\\\u00b2\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"geo\\\": {\\\"@type\\\": \\\"GeoCoordinates\\\", \\\"latitude\\\": 24.9857, \\\"longitude\\\": 55.0272}, \\\"openingHoursSpecification\\\": {\\\"@type\\\": \\\"OpeningHoursSpecification\\\", \\\"dayOfWeek\\\": [\\\"Monday\\\", \\\"Tuesday\\\", \\\"Wednesday\\\", \\\"Thursday\\\", \\\"Friday\\\", \\\"Saturday\\\"], \\\"opens\\\": \\\"09:00\\\", \\\"closes\\\": \\\"18:00\\\"}, \\\"areaServed\\\": [\\\"Dubai\\\", \\\"Abu Dhabi\\\", \\\"United Arab Emirates\\\", \\\"Saudi Arabia\\\", \\\"Qatar\\\", \\\"Kuwait\\\", \\\"Bahrain\\\", \\\"Oman\\\"]}\"}}]\n14:T682,<h1>SportPro 4.7mm</h1><p>Discover SportPro 4.7mm LED displays in Dubai. Enhance sports events with vibrant visuals. Contact Brightluxx UAE today for a free quote!</p><p><strong>Stadium-grade perimeter and scoreboard LED.</strong></p><p>Built for live sports: 10,000-nit brightness, impact-resistant face, instant content switching. Perimeter-compatible form factor with integrated padding. Used in FIFA and AFC-standard venues.</p><h2>FAQ</h2><h3>What is the pixel pitch of the SportPro 4.7mm and how does it affect image clarity?</h3><p>The SportPro features a 4.7mm pixel pitch, providing sharp and clear images suitable for viewing distances starting from 5 meters. This fine pitch ensures detailed content display, ideal for stadium perimeter and scoreboard applications.</p><h3>How bright is the SportPro 4.7mm and is it suitable for outdoor use in bright sunlight?</h3><p>With an impressive brightness of 10,000 nits, the SportPro 4.7mm delivers vivid visibility even under direct sunlight. Its high brightness makes it perfectly suited for outdoor sports venues with varying lighting conditions.</p><h3>What kind of impact protection does this LED display offer?</h3><p>The SportPro includes a soft mask and integrated padding to protect against physical impacts, making it durable enough to withstand the demands of live sports events, including ball strikes and accidental contact.</p><h3>Can the SportPro 4.7mm LED display be serviced easily if needed?</h3><p>Yes, the SportPro is designed with rear access serviceability, allowing technicians to perform maintenance or repairs efficiently without removing the entire unit from the installation frame.</p>7:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}]\n8:[\"$\",\"$L15\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@17\"}]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L18\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"SportPro 4.7mm LED Display | Premium Sports Screens Dubai | Brightluxx\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Discover SportPro 4.7mm LED displays in Dubai. Enhance sports events with vibrant visuals. Contact Brightluxx UAE today for a free quote!\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://brightluxx.com/products/bl-spx470\"}]]}]}]}],null]}]\nd:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L1a\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L1b\",null,{}]}]]}]\n10:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/37aunjb6qe2jr.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/36ljooz643x7p.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"children\":[\"$\",\"body\",null,{\"children\":[[\"$\",\"$L1c\",null,{}],[\"$\",\"$L1d\",null,{}],[\"$\",\"$L1a\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L1b\",null,{}],\"notFound\":[[\"$\",\"main\",null,{\"className\":\"not-found\",\"children\":[[\"$\",\"h1\",null,{\"children\":\"404 — Page Not Found\"}],[\"$\",\"p\",null,{\"children\":\"The p