"$\",\"$b\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L11\"}]}]}],null]}],false]],\"m\":\"$undefined\",\"G\":[\"$12\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/37aunjb6qe2jr.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"Imuj_2AFTFb5vAkEMopsc\"}\nd:C\n13:T57e,{\"@context\": \"https://schema.org\", \"@type\": \"Product\", \"name\": \"SportPro 4.7mm\", \"description\": \"Built for live sports: 10,000-nit brightness, impact-resistant face, instant content switching. Perimeter-compatible form factor with integrated padding. Used in FIFA and AFC-standard venues.\", \"sku\": \"BL-SPX470\", \"brand\": {\"@type\": \"Brand\", \"name\": \"Brightluxx\"}, \"manufacturer\": {\"@type\": \"Organization\", \"name\": \"Brightluxx\", \"url\": \"https://brightluxx.com\", \"logo\": \"https://files.ihgbrands.com/uploads_hero_banner.webp\"}, \"url\": \"https://brightluxx.com/products/bl-spx470\", \"category\": \"outdoor\", \"image\": \"https://files.ihgbrands.com/brightluxx/site-images/prod_bl-spx470.webp\", \"offers\": {\"@type\": \"AggregateOffer\", \"priceCurrency\": \"USD\", \"lowPrice\": 600, \"highPrice\": 5000, \"offerCount\": 1, \"availability\": \"https://schema.org/InStock\", \"seller\": {\"@type\": \"Organization\", \"name\": \"Brightluxx\", \"url\": \"https://brightluxx.com\", \"logo\": \"https://files.ihgbrands.com/uploads_hero_banner.webp\"}, \"url\": \"https://brightluxx.com/products/bl-spx470\"}, \"additionalProperty\": [{\"@type\": \"PropertyValue\", \"name\": \"Pixel Pitch\", \"value\": \"4.7mm\"}, {\"@type\": \"PropertyValue\", \"name\": \"Brightness\", \"value\": \"10,000 nits\"}, {\"@type\": \"PropertyValue\", \"name\": \"Resolution\", \"value\": \"204 x 204 per panel\"}, {\"@type\": \"PropertyValue\", \"name\": \"Warranty\", \"value\": \"3 Years Standard | 5 Years Extended Available\"}]}14:Tc1e,{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What is the pixel pitch of the SportPro 4.7mm and how does it affect image clarity?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The SportPro features a 4.7mm pixel pitch, providing sharp and clear images suitable for viewing distances starting from 5 meters. This fine pitch ensures detailed content display, ideal for stadium perimeter and scoreboard applications.\"}}, {\"@type\": \"Question\", \"name\": \"How bright is the SportPro 4.7mm and is it suitable for outdoor use in bright sunlight?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"With an impressive brightness of 10,000 nits, the SportPro 4.7mm delivers vivid visibility even under direct sunlight. Its high brightness makes it perfectly suited for outdoor sports venues with varying lighting conditions.\"}}, {\"@type\": \"Question\", \"name\": \"What kind of impact protection does this LED display offer?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The SportPro includes a soft mask and integrated padding to protect against physical impacts, making it durable enough to withstand the demands of live sports events, including ball strikes and accidental contact.\"}}, {\"@type\": \"Question\", \"name\": \"Can the SportPro 4.7mm LED display be serviced easily if needed?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, the SportPro is designed with rear access serviceability, allowing technicians to perform maintenance or repairs efficiently without removing the entire unit from the installation frame.\"}}, {\"@type\": \"Question\", \"name\": \"Is the SportPro compliant with international sports standards?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Absolutely, the SportPro 4.7mm LED display complies with FIFA and AFC standards, ensuring it meets stringent requirements for use in professional sports stadiums worldwide.\"}}, {\"@type\": \"Question\", \"name\": \"How does the SportPro 4.7mm compare to other outdoor LED displays in the market?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The SportPro stands out with its combination of high brightness (10,000 nits), impact-resistant design, and a specialized perimeter-compatible form factor. This makes it particularly suitable for stadium environments compared to general-purpose outdoor displays.\"}}, {\"@type\": \"Question\", \"name\": \"What is the typical installation setup for the SportPro 4.7mm display?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The SportPro is designed for easy perimeter and scoreboard installation with 960 x 960mm panels and a lightweight 32kg per panel profile. This modular design allows flexible configuration and quick set-up at stadium venues.\"}}, {\"@type\": \"Question\", \"name\": \"What warranty and after-sales support are provided for this product?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Brightluxx offers comprehensive warranty coverage along with dedicated customer support, ensuring your SportPro LED display operates reliably over its service life. Specific warranty terms can be discussed with our sales team based on project scope.\"}}]}9:[\"$\",\"main\",null,{\"data-testid\":\"next-server-rendered-parity-page\",\"children\":[[[\"$\",\"script\",\"0\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$13\"}}],[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}],\"$L15\",\"$L16\",\"$L17\"],\"$L18\"]}]\n15:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"BreadcrumbList\\\", \\\"itemListElement\\\": [{\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 1, \\\"name\\\": \\\"Home\\\", \\\"item\\\": \\\"https://brightluxx.com\\\"}, {\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 2, \\\"name\\\": \\\"Products\\\", \\\"item\\\": \\\"https://brightluxx.com/products\\\"}, {\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 3, \\\"name\\\": \\\"SportPro 4.7mm\\\", \\\"item\\\": \\\"https://brightluxx.com/products/bl-spx470\\\"}]}\"}}]\n16:[\"$\",\"script\",\"3\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"Organization\\\", \\\"@id\\\": \\\"https://brightluxx.com/#organization\\\", \\\"name\\\": \\\"Brightluxx\\\", \\\"legalName\\\": \\\"Brightluxx LED Displays\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"logo\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"contactPoint\\\": {\\\"@type\\\": \\\"ContactPoint\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"contactType\\\": \\\"sales\\\", \\\"areaServed\\\": [\\\"AE\\\", \\\"SA\\\", \\\"QA\\\", \\\"KW\\\", \\\"BH\\\", \\\"OM\\\"], \\\"availableLanguage\\\": [\\\"en\\\", \\\"ar\\\"]}}\"}}]\n17:[\"$\",\"script\",\"4\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"LocalBusiness\\\", \\\"@id\\\": \\\"https://brightluxx.com/#localbusiness\\\", \\\"name\\\": \\\"Brightluxx LED Displays\\\", \\\"image\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"priceRange\\\": \\\"AED 2,500 - AED 12,000 per m\\\\u00b2\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"geo\\\": {\\\"@type\\\": \\\"GeoCoordinates\\\", \\\"latitude\\\": 24.9857, \\\"longitude\\\": 55.0272}, \\\"openingHoursSpecification\\\": {\\\"@type\\\": \\\"OpeningHoursSpecification\\\", \\\"dayOfWeek\\\": [\\\"Monday\\\", \\\"Tuesday\\\", \\\"Wednesday\\\", \\\"Thursday\\\", \\\"Friday\\\", \\\"Saturday\\\"], \\\"opens\\\": \\\"09:00\\\", \\\"closes\\\": \\\"18:00\\\"}, \\\"areaServed\\\": [\\\"Dubai\\\", \\\"Abu Dhabi\\\", \\\"United Arab Emirates\\\", \\\"Saudi Arabia\\\", \\\"Qatar\\\", \\\"Kuwait\\\", \\\"Bahrain\\\", \\\"Oman\\\"]}\"}}]\n19:T682,<h1>SportPro 4.7mm</h1><p>Discover SportPro 4.7mm LED displays in Dubai. Enhance sports events with vibrant visuals. Contact Brightluxx UAE today for a free quote!</p><p><strong>Stadium-grade perimeter and scoreboard LED.</strong></p><p>Built for live sports: 10,000-nit brightness, impact-resistant face, instant content switching. Perimeter-compatible form factor with integrated padding. Used in FIFA and AFC-standard venues.</p><h2>FAQ</h2><h3>What is the pixel pitch of the SportPro 4.7mm and how does it affect image clarity?</h3><p>The SportPro features a 4.7mm pixel pitch, providing sharp and clear images suitable for viewing distances starting from 5 meters. This fine pitch ensures detailed content display, ideal for stadium perimeter and scoreboard applications.</p><h3>How bright is the SportPro 4.7mm and is it suitable for outdoor use in bright sunlight?</h3><p>With an impressive brightness of 10,000 nits, the SportPro 4.7mm delivers vivid visibility even under direct sunlight. Its high brightness makes it perfectly suited for outdoor sports venues with varying lighting conditions.</p><h3>What kind of impact protection does this LED display offer?</h3><p>The SportPro includes a soft mask and integrated padding to protect against physical impacts, making it durable enough to withstand the demands of live sports events, including ball strikes and accidental contact.</p><h3>Can the SportPro 4.7mm LED display be serviced easily if needed?</h3><p>Yes, the SportPro is designed with rear access serviceability, allowing technicians to perform maintenance or repairs efficiently without removing the entire unit from the installation frame.</p>18:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$19\"}}]\nf:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nc:null\n11:[[\"$\",\"title\",\"0\",{\"children\":\"SportPro 4.7mm LED Display | Premium Sports Screens Dubai | Brightluxx\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Discover SportPro 4.7mm LED displays in Dubai. Enhance sports events with vibrant visuals. Contact Brightluxx UAE today for a free quote!\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://brightluxx.com/products/bl-spx470\"}]]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/37aunjb6qe2jr.css\",\"style\"]\n:HL[\"https://files.ihgbrands.com/assets_brightluxx-logo-nav.png\",\"image\"]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":4176,\"slots\":{\"children\":{\"name\":\"slug\",\"param\":{\"type\":\"c\",\"key\":\"products/bl-spx470\",\"siblings\":[\"products\"]},\"prefetchHints\":4192,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":4256,\"slots\":null}}}}},\"staleTime\":300,\"buildId\":\"Imuj_2AFTFb5vAkEMopsc\"}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[31262,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"PageViewTracker\"]\n3:I[48303,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"SiteHeader\"]\n4:I[39756,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"default\"]\n5:I[37457,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"default\"]\n6:I[22016,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"\"]\n7:I[52006,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"FloatingActions\"]\n8:I[81888,[\"/_next/static/chunks/36ljooz643x7p.js\"],\"CookieConsent\"]\na:I[97367