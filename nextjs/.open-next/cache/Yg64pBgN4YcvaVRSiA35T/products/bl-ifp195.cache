/files.ihgbrands.com/uploads_hero_banner.webp\"}, \"url\": \"https://brightluxx.com/products/bl-ifp195\"}, \"additionalProperty\": [{\"@type\": \"PropertyValue\", \"name\": \"Pixel Pitch\", \"value\": \"1.95mm\"}, {\"@type\": \"PropertyValue\", \"name\": \"Brightness\", \"value\": \"800 nits\"}, {\"@type\": \"PropertyValue\", \"name\": \"Resolution\", \"value\": \"320 x 180 per panel\"}, {\"@type\": \"PropertyValue\", \"name\": \"Warranty\", \"value\": \"3 Years Standard | 5 Years Extended Available\"}]}14:Ta39,{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What is the pixel pitch of the IndoorFine 1.9mm?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The IndoorFine 1.9mm features a pixel pitch of 1.95mm, providing exceptionally high resolution, ideal for close viewing distances in professional indoor environments.\"}}, {\"@type\": \"Question\", \"name\": \"How bright is the IndoorFine 1.9mm display?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"This LED display offers a brightness level of 800 nits, ensuring clear and vibrant images in indoor settings such as TV studios and corporate environments.\"}}, {\"@type\": \"Question\", \"name\": \"Is the IndoorFine 1.9mm suitable for large video wall installations?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, with seamless module-level calibration and uniform color temperature adjustment from 3000 to 9500K, it ensures consistent color uniformity across large-scale video walls.\"}}, {\"@type\": \"Question\", \"name\": \"What are the power consumption and lifespan of this display?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The display consumes an average power of 240W per square meter and boasts a long lifespan of up to 100,000 hours, ensuring energy efficiency and durability.\"}}, {\"@type\": \"Question\", \"name\": \"How does the IndoorFine 1.9mm compare to standard pitch indoor LED displays?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Compared to standard indoor LEDs, this fine pitch display provides superior pixel density and refresh rates (up to 3,840Hz), delivering smoother motion and crisper images, especially critical for broadcast and high-end corporate installations.\"}}, {\"@type\": \"Question\", \"name\": \"What warranty and support options are available?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Brightluxx offers comprehensive warranty and after-sales support for the IndoorFine 1.9mm, including installation assistance and maintenance plans to ensure peak performance.\"}}, {\"@type\": \"Question\", \"name\": \"Can this LED display be installed in houses of worship?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Absolutely. Its fine pixel pitch and high contrast ratio (5,000:1) create clear, vibrant visuals ideal for worship spaces where audience engagement and visibility are key.\"}}, {\"@type\": \"Question\", \"name\": \"Is professional installation required for the IndoorFine 1.9mm?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, due to its precise calibration requirements and panel handling, professional installation is recommended to guarantee optimal performance and uniformity.\"}}]}9:[\"$\",\"main\",null,{\"data-testid\":\"next-server-rendered-parity-page\",\"children\":[[[\"$\",\"script\",\"0\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$13\"}}],[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}],\"$L15\",\"$L16\",\"$L17\"],\"$L18\"]}]\n15:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"BreadcrumbList\\\", \\\"itemListElement\\\": [{\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 1, \\\"name\\\": \\\"Home\\\", \\\"item\\\": \\\"https://brightluxx.com\\\"}, {\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 2, \\\"name\\\": \\\"Products\\\", \\\"item\\\": \\\"https://brightluxx.com/products\\\"}, {\\\"@type\\\": \\\"ListItem\\\", \\\"position\\\": 3, \\\"name\\\": \\\"IndoorFine 1.9mm\\\", \\\"item\\\": \\\"https://brightluxx.com/products/bl-ifp195\\\"}]}\"}}]\n16:[\"$\",\"script\",\"3\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"Organization\\\", \\\"@id\\\": \\\"https://brightluxx.com/#organization\\\", \\\"name\\\": \\\"Brightluxx\\\", \\\"legalName\\\": \\\"Brightluxx LED Displays\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"logo\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"contactPoint\\\": {\\\"@type\\\": \\\"ContactPoint\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"contactType\\\": \\\"sales\\\", \\\"areaServed\\\": [\\\"AE\\\", \\\"SA\\\", \\\"QA\\\", \\\"KW\\\", \\\"BH\\\", \\\"OM\\\"], \\\"availableLanguage\\\": [\\\"en\\\", \\\"ar\\\"]}}\"}}]\n17:[\"$\",\"script\",\"4\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\": \\\"https://schema.org\\\", \\\"@type\\\": \\\"LocalBusiness\\\", \\\"@id\\\": \\\"https://brightluxx.com/#localbusiness\\\", \\\"name\\\": \\\"Brightluxx LED Displays\\\", \\\"image\\\": \\\"https://brightluxx.com/android-chrome-512x512.png\\\", \\\"url\\\": \\\"https://brightluxx.com\\\", \\\"telephone\\\": \\\"+971559954274\\\", \\\"priceRange\\\": \\\"AED 2,500 - AED 12,000 per m\\\\u00b2\\\", \\\"address\\\": {\\\"@type\\\": \\\"PostalAddress\\\", \\\"streetAddress\\\": \\\"Jebel Ali Industrial Area 1\\\", \\\"addressLocality\\\": \\\"Dubai\\\", \\\"addressCountry\\\": \\\"AE\\\"}, \\\"geo\\\": {\\\"@type\\\": \\\"GeoCoordinates\\\", \\\"latitude\\\": 24.9857, \\\"longitude\\\": 55.0272}, \\\"openingHoursSpecification\\\": {\\\"@type\\\": \\\"OpeningHoursSpecification\\\", \\\"dayOfWeek\\\": [\\\"Monday\\\", \\\"Tuesday\\\", \\\"Wednesday\\\", \\\"Thursday\\\", \\\"Friday\\\", \\\"Saturday\\\"], \\\"opens\\\": \\\"09:00\\\", \\\"closes\\\": \\\"18:00\\\"}, \\\"areaServed\\\": [\\\"Dubai\\\", \\\"Abu Dhabi\\\", \\\"United Arab Emirates\\\", \\\"Saudi Arabia\\\", \\\"Qatar\\\", \\\"Kuwait\\\", \\\"Bahrain\\\", \\\"Oman\\\"]}\"}}]\n19:T571,<h1>IndoorFine 1.9mm</h1><p>Shop IndoorFine 1.9mm LED displays in Dubai. Ideal for conferences &amp; exhibitions. Contact Brightluxx UAE for custom indoor LED solutions!</p><p><strong>Versatile fine-pitch for any professional space.</strong></p><p>Fine-pitch all-rounder for TV studios, houses of worship, and mid-size corporate video walls. Seamless calibration across large arrays and consistent colour uniformity. Module-level calibration.</p><h2>FAQ</h2><h3>What is the pixel pitch of the IndoorFine 1.9mm?</h3><p>The IndoorFine 1.9mm features a pixel pitch of 1.95mm, providing exceptionally high resolution, ideal for close viewing distances in professional indoor environments.</p><h3>How bright is the IndoorFine 1.9mm display?</h3><p>This LED display offers a brightness level of 800 nits, ensuring clear and vibrant images in indoor settings such as TV studios and corporate environments.</p><h3>Is the IndoorFine 1.9mm suitable for large video wall installations?</h3><p>Yes, with seamless module-level calibration and uniform color temperature adjustment from 3000 to 9500K, it ensures consistent color uniformity across large-scale video walls.</p><h3>What are the power consumption and lifespan of this display?</h3><p>The display consumes an average power of 240W per square meter and boasts a long lifespan of up to 100,000 hours, ensuring energy efficiency and durability.</p>18:[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{